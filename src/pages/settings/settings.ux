<template>
  <div class="page">
    <div class="bg"></div>
    <div class="glow"></div>

    <div class="back" onclick="goBack">
      <div class="back-arrow"></div>
    </div>
    <text class="h-title">设置</text>

    <div class="stat-card">
      <text class="stat-label" style="top:34px;">当前进度</text>
      <text class="stat-value" style="top:30px;">{{unlocked}} / 8</text>
      <text class="stat-sub" style="top:66px;">已解锁关卡</text>
      <div class="divider"></div>
      <text class="stat-label" style="top:182px;">获得星星</text>
      <text class="stat-value" style="top:178px;">{{totalStars}} / 24</text>
      <text class="stat-sub" style="top:214px;">所有关卡累计</text>
    </div>

    <!-- 清空存档 -->
    <div class="row row-danger" onclick="askClear">
      <div class="trash">
        <div class="trash-lid"></div>
        <div class="trash-body"></div>
        <div class="trash-line"></div>
      </div>
      <text class="row-text danger-text">清空游戏数据</text>
      <div class="chev"></div>
    </div>

    <!-- 退出 -->
    <div class="row row-exit" onclick="quitApp">
      <div class="power">
        <div class="power-ring"></div>
        <div class="power-gap"></div>
        <div class="power-stem"></div>
      </div>
      <text class="row-text">退出应用</text>
      <div class="chev"></div>
    </div>

    <text class="version">跳舞的线 v1.0.0</text>
    <text class="version2">Xiaomi Vela · Band 9</text>

    <!-- 清空确认 -->
    <div class="overlay" if="{{confirming}}">
      <div class="panel">
        <text class="p-title">清空数据？</text>
        <text class="p-sub">所有关卡解锁与成绩\n将被永久删除</text>
        <div class="btn danger" onclick="doClear">
          <text class="btn-text">确认清空</text>
        </div>
        <div class="btn ghost" onclick="cancelClear">
          <text class="btn-text dim">取消</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'
import { readSave, clearSave, emptySave } from '../../common/save.js'

export default {
  private: {
    unlocked: 1,
    totalStars: 0,
    confirming: false
  },

  onInit() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  refresh() {
    readSave((s) => {
      this.unlocked = s.unlocked
      let sum = 0
      for (let i = 1; i <= 8; i++) sum += (s.stars[i] || 0)
      this.totalStars = sum
    })
  },

  goBack() {
    router.back()
  },

  askClear() {
    this.confirming = true
  },

  cancelClear() {
    this.confirming = false
  },

  doClear() {
    clearSave(() => {
      const s = emptySave()
      this.unlocked = s.unlocked
      this.totalStars = 0
      this.confirming = false
      this.keepRefresh = true
    })
  },

  quitApp() {
    try {
      app.terminate()
    } catch (e) {
      router.back()
    }
  }
}
</script>

