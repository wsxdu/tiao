<template>
  <div class="page">
    <div class="bg"></div>
    <div class="glow"></div>

    <div class="back" onclick="goBack">
      <div class="back-arrow"></div>
    </div>
    <text class="h-title">关于</text>

    <!-- 代码绘制的标志 -->
    <div class="mini-logo">
      <div class="mblock" for="{{(i, item) in blocks}}" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.w}}px;background-color:{{item.c}};border-radius:{{item.r}}px;"></div>
      <div class="mtail"></div>
    </div>

    <text class="app-name">跳舞的线</text>
    <text class="app-en">DANCING LINE</text>
    <text class="version">版本 1.0.0 · Vela 快应用</text>

    <div class="card">
      <text class="card-title">游戏简介</text>
      <text class="card-body">一款跟着节奏前进的线条游戏。线会自动向前，在弯道处点击屏幕即可转向。走完全程即可过关，冲出路外则挑战失败。</text>
    </div>

    <div class="card card2">
      <text class="card-title">玩法说明</text>
      <text class="card-line" style="top:70px;">· 点击屏幕：在弯道处转向</text>
      <text class="card-line" style="top:112px;">· 提前点击无效，靠近弯点再点</text>
      <text class="card-line" style="top:154px;">· 连续过关可解锁新关卡</text>
      <text class="card-line" style="top:196px;">· 成绩会自动保存在手环中</text>
    </div>

    <div class="tips">
      <div class="tip-dot"></div>
      <text class="tip-text">建议佩戴稳固，跟随画面节拍点击</text>
    </div>

    <text class="footer">FOR XIAOMI BAND 9 · XIAOMI VELA</text>
  </div>
</template>

<script>
import router from '@system.router'

const COLORS = ['#4fe0ff', '#5dd0ff', '#74b8ff', '#918fff', '#b477ff', '#d964e8', '#ff5fa8']

export default {
  private: {
    blocks: []
  },

  onInit() {
    const arr = []
    for (let i = 0; i < 7; i++) {
      const x = 196 + i * 13
      const y = 300 - i * 12 - Math.sin(i) * 8
      const w = 12 + i
      arr.push({
        x: Math.round(x),
        y: Math.round(y),
        w: w,
        c: COLORS[i],
        r: 4
      })
    }
    this.blocks = arr
  },

  goBack() {
    router.back()
  }
}
</script>

