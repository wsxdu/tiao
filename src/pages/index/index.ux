<template>
  <div class="page" onswipe="onSwipe">
    <!-- 背景 -->
    <div class="bg"></div>
    <div class="spot spot1"></div>
    <div class="spot spot2"></div>
    <div class="grid-line" for="{{(i, item) in gridLines}}" style="top:{{item.y}}px;opacity:{{item.o}};"></div>

    <!-- 顶部标识 -->
    <text class="brand">XIAOMI BAND 9 · VELA</text>
    <div class="brand-dot"></div>

    <!-- 由代码绘制的“跳舞的线”标志 -->
    <div class="logo-wrap">
      <div
        class="logo-block"
        for="{{(i, item) in logoBlocks}}"
        style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.w}}px;background-color:{{item.c}};border-radius:{{item.r}}px;opacity:{{item.o}};"
      ></div>
      <div class="logo-tail" style="left:{{tailX}}px;top:{{tailY}}px;"></div>
    </div>

    <text class="title">跳舞的线</text>
    <text class="en-title">DANCING LINE</text>
    <text class="slogan">跟着节奏 · 一笔到底</text>

    <!-- 开始 -->
    <div class="start-btn" onclick="goLevels">
      <div class="start-play">
        <div class="play-tri"></div>
      </div>
      <text class="start-text">开始游戏</text>
    </div>

    <!-- 关于 / 设置 -->
    <div class="bottom-row">
      <div class="icon-btn btn-about" onclick="goAbout">
        <div class="icon-circle">
          <div class="about-dot"></div>
          <div class="about-stem"></div>
          <div class="about-ring"></div>
        </div>
        <text class="icon-label">关于</text>
      </div>
      <div class="icon-btn btn-gear" onclick="goSettings">
        <div class="icon-circle">
          <div class="gear-tooth" for="{{(i, item) in gearTeeth}}" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;border-radius:{{item.r}}px;"></div>
          <div class="gear-ring"></div>
          <div class="gear-hole"></div>
        </div>
        <text class="icon-label">设置</text>
      </div>
    </div>

    <text class="hint">向右滑动 · 进入关卡</text>
  </div>
</template>

<script>
import router from '@system.router'

const COLORS = ['#4fe0ff', '#5dd0ff', '#74b8ff', '#918fff', '#b477ff', '#d964e8', '#ff5fa8', '#ff7d94']

export default {
  private: {
    logoBlocks: [],
    gearTeeth: [],
    gridLines: [],
    tailX: 0,
    tailY: 0
  },

  onInit() {
    this.buildLogo()
    this.buildGear()
    this.buildGrid()
  },

  buildLogo() {
    const arr = []
    let lastX = 88
    let lastY = 420
    for (let i = 0; i < 14; i++) {
      const t = i / 13
      const x = 88 + i * 22
      // 一条向上跳动的波浪线
      const bump = Math.sin(t * Math.PI * 1.7) * 46
      const y = 432 - i * 9 - bump
      const size = 13 + Math.round(t * 8)
      arr.push({
        x: Math.round(x - size / 2),
        y: Math.round(y - size / 2),
        w: size,
        c: COLORS[i % COLORS.length],
        r: Math.round(size / 3),
        o: 0.55 + t * 0.45
      })
      lastX = x
      lastY = y
    }
    this.logoBlocks = arr
    this.tailX = Math.round(lastX - 14)
    this.tailY = Math.round(lastY - 14)
  },

  buildGear() {
    const arr = []
    const cx = 65
    const cy = 65
    const r = 46
    for (let i = 0; i < 8; i++) {
      const a = (Math.PI * 2 * i) / 8
      arr.push({
        x: Math.round(cx + Math.cos(a) * r - 5),
        y: Math.round(cy + Math.sin(a) * r - 5),
        w: 10,
        h: 10,
        r: 2
      })
    }
    this.gearTeeth = arr
  },

  buildGrid() {
    const arr = []
    for (let i = 0; i < 6; i++) {
      arr.push({ y: 700 + i * 80, o: 0.05 - i * 0.006 })
    }
    this.gridLines = arr
  },

  goLevels() {
    router.push({ uri: '/pages/levels' })
  },

  goAbout() {
    router.push({ uri: '/pages/about' })
  },

  goSettings() {
    router.push({ uri: '/pages/settings' })
  },

  onSwipe(e) {
    if (!e) return
    if (e.direction === 'right' || e.direction === 'left') {
      router.push({ uri: '/pages/levels' })
    }
  }
}
</script>

