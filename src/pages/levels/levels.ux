      <div class="card" onclick="open4" style="opacity:{{l4 ? 0.45 : 1}};">
        <div class="cover" style="background-color:#0b1a26;">
          <div class="cv-el" for="{{(i, item) in cover4}}" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;background-color:{{item.c}};opacity:{{item.o}};border-radius:{{item.rd}}px;"></div>
