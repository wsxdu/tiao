          <div class="cv-el" for="{{(i, item) in cover6}}" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;background-color:{{item.c}};opacity:{{item.o}};border-radius:{{item.rd}}px;"></div>
          <div class="lock" if="{{l6}}">
