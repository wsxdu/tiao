      </div>

      <div class="card" onclick="open7" style="opacity:{{l7 ? 0.45 : 1}};">
        <div class="cover" style="background-color:#20160c;">
          <div class="cv-el" for="{{(i, item) in cover7}}" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;background-color:{{item.c}};opacity:{{item.o}};border-radius:{{item.rd}}px;"></div>
          <div class="lock" if="{{l7}}">
            <div class="lock-body"></div>
            <div class="lock-ring"></div>
          </div>
        </div>
        <text class="c-no">07</text>
        <text class="c-name">秋天</text>
        <text class="c-en">THE AUTUMN</text>
        <div class="stars">
          <div class="star" for="{{(i, item) in st7}}" style="left:{{i * 30}}px;background-color:{{item.c}};"></div>
        </div>
        <text class="c-best">最佳 {{best7}}%</text>
      </div>

      <div class="card" onclick="open8" style="opacity:{{l8 ? 0.45 : 1}};">
        <div class="cover" style="background-color:#121a24;">
          <div class="cv-el" for="{{(i, item) in cover8}}" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;background-color:{{item.c}};opacity:{{item.o}};border-radius:{{item.rd}}px;"></div>
          <div class="lock" if="{{l8}}">
            <div class="lock-body"></div>
            <div class="lock-ring"></div>
          </div>
        </div>
        <text class="c-no">08</text>
        <text class="c-name">山脉</text>
        <text class="c-en">THE MOUNTAINS</text>
        <div class="stars">
          <div class="star" for="{{(i, item) in st8}}" style="left:{{i * 30}}px;background-color:{{item.c}};"></div>
