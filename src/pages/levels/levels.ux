      </div>

      <div class="card" onclick="open5" style="opacity:{{l5 ? 0.45 : 1}};">
        <div class="cover" style="background-color:#1b0c22;">
          <div class="cv-el" for="{{(i, item) in cover5}}" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;background-color:{{item.c}};opacity:{{item.o}};border-radius:{{item.rd}}px;"></div>
          <div class="lock" if="{{l5}}">
