}

.btn.ghost {
  top: 298px;
  background-color: #182740;
}

.btn-text {
  position: absolute;
  left: 0;
  top: 24px;
  width: 280px;
  text-align: center;
  font-size: 30px;
  color: #ffffff;
  font-weight: bold;
}

.btn-text.dim {
  color: #9db6d6;
}

.win-stars {
  position: absolute;
